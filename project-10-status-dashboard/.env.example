# /etc/statusdash/statusdash.env  (root:statusdash 0640) — shared by the blue and green instances
DATABASE_URL=postgresql://statusdash_owner:CHANGE_ME@ep-xxxx-pooler.eu-central-1.aws.neon.tech/statusdash?sslmode=require
REDIS_URL=rediss://default:CHANGE_ME@your-db-12345.upstash.io:6379
# How often each monitor is checked (seconds)
CHECK_INTERVAL_S=60
# Per-check HTTP timeout (ms)
CHECK_TIMEOUT_MS=8000
# Per-colour files /etc/statusdash/blue.env and green.env set PORT and COLOR
