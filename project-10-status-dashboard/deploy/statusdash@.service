# /etc/systemd/system/statusdash@.service — TEMPLATE unit: statusdash@blue / statusdash@green
# %i = instance name (blue|green). Each colour points to its own release via a symlink:
#   /opt/statusdash/blue  -> /opt/statusdash/releases/<id-A>
#   /opt/statusdash/green -> /opt/statusdash/releases/<id-B>
[Unit]
Description=Project 10 status dashboard (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=statusdash
Group=statusdash
EnvironmentFile=/etc/statusdash/statusdash.env
EnvironmentFile=/etc/statusdash/%i.env
# The symlink is resolved when the service STARTS — a later re-point doesn't affect a running instance
WorkingDirectory=/opt/statusdash/%i/server
ExecStart=/usr/local/bin/bun run server.ts
Environment=HOME=/tmp
Environment=NODE_ENV=production
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=2
MemoryMax=150M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
SyslogIdentifier=statusdash-%i

[Install]
WantedBy=multi-user.target
