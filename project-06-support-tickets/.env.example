# /etc/tickets/tickets.env  (root:tickets 0640) — read by api/bootstrap.php
# Aiven console → your MySQL service → Overview → Connection information
DB_HOST=mysql-tickets-yourproject.a.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASS=CHANGE_ME
# Download "CA certificate" from the Aiven service page and save it here (root:tickets 0640)
DB_SSL_CA=/etc/tickets/aiven-ca.pem
# Initial agent account created by db/seed.php
SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=ChangeMe-Str0ng!
APP_NAME="HelpDesk Lite"
