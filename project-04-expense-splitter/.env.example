# /etc/expense/expense.env  (root:expense 0640)
# Neon console → Connection details → "Pooled connection" string. Keep sslmode=require.
DATABASE_URL=postgresql://expense_owner:CHANGE_ME@ep-cool-name-123456-pooler.eu-central-1.aws.neon.tech/expense?sslmode=require
# Uvicorn bind (internal only)
HOST=127.0.0.1
PORT=5004
# Pool sizing — keep tiny on a 1 GB box and Neon free tier
DB_POOL_MIN=1
DB_POOL_MAX=4
LOG_LEVEL=info
