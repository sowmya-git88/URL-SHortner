# /etc/caddy/Caddyfile — Project 04 (Caddy deep-dive)
#
# Global options block: applies to the whole Caddy instance.
{
	# Uncomment to receive Let's Encrypt expiry emails:
	# email you@example.com

	# Admin API stays on localhost (used by `caddy reload`)
	admin localhost:2019

	servers {
		# Trust X-Forwarded-* only from loopback (nothing sits in front of Caddy here)
		trusted_proxies static 127.0.0.1/32
	}
}

# Reusable snippet = DRY config for both site addresses
(expense_app) {
	encode zstd gzip

	# ---- 1. API: keep the /api prefix (FastAPI routes are defined WITH /api) ----
	# `handle` does NOT strip the prefix. `handle_path /api/*` WOULD strip it
	# and FastAPI would receive /groups instead of /api/groups → 404.
	handle /api/* {
		reverse_proxy 127.0.0.1:5004 {
			header_up X-Real-IP {remote_host}
			# Retry for up to 5s while uvicorn restarts during a deploy
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	# ---- 2. Everything else: the static SPA ----
	handle {
		root * /opt/expense/web
		# SPA fallback: unknown paths serve index.html
		try_files {path} /index.html
		file_server
		@assets path *.js *.css
		header @assets Cache-Control "public, max-age=3600"
	}

	# ---- 3. Security headers on every response ----
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
		-Server
	}

	# ---- 4. Friendly error page when the API is down ----
	handle_errors 502 503 504 {
		respond "API temporarily unavailable ({err.status_code}). Try again in a few seconds." {err.status_code}
	}

	log {
		output file /var/log/caddy/expense.access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# HTTPS: Caddy sees a public hostname → obtains a Let's Encrypt cert via HTTP-01/TLS-ALPN-01
{$EC2_IP}.sslip.io {
	import expense_app
}

# HTTP only on the bare IP. Note: HSTS header is ignored by browsers over plain HTTP.
http://{$EC2_IP} {
	import expense_app
}
