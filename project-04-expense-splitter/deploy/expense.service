# /etc/systemd/system/expense.service
[Unit]
Description=Project 04 Expense Splitter (FastAPI + Uvicorn)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=expense
Group=expense
WorkingDirectory=/opt/expense/api
EnvironmentFile=/etc/expense/expense.env
ExecStart=/opt/expense/venv/bin/uvicorn main:app --host ${HOST} --port ${PORT} --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --log-level ${LOG_LEVEL} --no-server-header
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
MemoryMax=180M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
SyslogIdentifier=expense

[Install]
WantedBy=multi-user.target
