# /etc/urlshort/urlshort.env  (owner root:urlshort, mode 0640)
# Absolute path of the SQLite file. /var/lib = variable state data (FHS).
DB_PATH=/var/lib/urlshort/urlshort.db
# Length of generated short codes
CODE_LENGTH=6
# Optional: force the base URL printed for short links (leave empty to derive from the request Host header)
PUBLIC_BASE_URL=
# Gunicorn bind address (internal only, never public)
BIND=127.0.0.1:5001
