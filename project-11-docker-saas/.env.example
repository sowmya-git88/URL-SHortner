# Copy to .env next to docker-compose.yml (docker compose reads it automatically). Never commit .env.
COMPOSE_PROJECT_NAME=saas
# Hostname for Caddy. Laptop default works offline with Caddy's internal CA.
# On a LAN, use e.g. 192.168.1.50.sslip.io (TLS still from the internal CA: Let's Encrypt can't reach your laptop).
SITE_HOST=127.0.0.1.sslip.io

POSTGRES_USER=saas
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=saas

REDIS_PASSWORD=change-me-redis

MINIO_ROOT_USER=saasminio
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8
MINIO_BUCKET=saas-files

# Rate limit for the API (requests per minute per client IP, enforced in Redis)
RATE_LIMIT_PER_MIN=120
