# /etc/snippetbin/snippetbin.env  (root:snippetbin 0640)
# Upstash console → your Redis database → "Connect" → Redis (TLS) URL. Note the rediss:// scheme (double s = TLS).
REDIS_URL=rediss://default:CHANGE_ME@apn1-intent-cobra-12345.upstash.io:6379
RACK_ENV=production
PORT=5007
BIND=127.0.0.1
# Plain-text access log consumed by scripts/log_analyzer.sh
ACCESS_LOG=/var/log/snippetbin/access.log
DEFAULT_TTL_HOURS=72
