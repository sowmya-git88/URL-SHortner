# /etc/mdblog/mdblog.env  (root:mdblog 0640)
BIND_ADDR=127.0.0.1:5009
# Cloudflare dashboard → right sidebar "Account ID"
CF_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# Workers & Pages → D1 → your database → Database ID
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
# My Profile → API Tokens → Create token with "Account · D1 · Edit"
CF_API_TOKEN=CHANGE_ME
# R2 → Manage R2 API tokens → Create (Object Read & Write) → Access Key ID / Secret
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=mdblog-media
# Long random string: openssl rand -hex 32
ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Local disk cache for media fetched from R2 (cleaned by disk_cleanup.sh)
MEDIA_CACHE_DIR=/var/cache/mdblog/media
# Failed admin logins are written here for Fail2Ban
AUTH_LOG=/var/log/mdblog/auth.log
RUST_LOG=info
