# Copy to .env (docker compose reads it). Never commit .env.
COMPOSE_PROJECT_NAME=obs
POSTGRES_USER=store
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=store
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Public port of the shop (Nginx container). 8080 avoids clashing with Project 11's Caddy on :80
WEB_PORT=8080
# JVM heap cap for the Spring Boot container
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
